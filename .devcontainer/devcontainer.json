{
  "name": "boot.dev-Go",
  "image": "mcr.microsoft.com/devcontainers/go:1-1.24-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": true,
        "[go]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "golang.go"
        }
      }
    }
  },
  "postCreateCommand": "/bin/bash -lc 'go install github.com/bootdotdev/bootdev@latest && bootdev --version'",
  "remoteUser": "vscode",
  "updateRemoteUserUID": true
}